# Copy to apps/server/.env and fill in; never commit .env to git

# LINE Login channel (LINE Developers Console → your LINE Login channel → Basic settings)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Public URL of this server; the LINE callback is PUBLIC_URL/auth/line/callback
# Local: http://localhost:2567; production example: https://api.salem.example.com
PUBLIC_URL=http://localhost:2567

# Frontend URLs allowed as post-login redirect targets (comma-separated)
WEB_ORIGINS=http://localhost:5173

# Key used to sign login tokens (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Local-dev test login (lets one computer open several windows as different identities); never enable in production
AUTH_DEV_LOGIN=1
