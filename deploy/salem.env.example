# Copy to deploy/salem.env (don't commit it to git)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Game server's public URL (the LINE Callback URL is this + /auth/line/callback)
PUBLIC_URL=https://salem-api.mochigogo.fun
# Frontend URL (Cloudflare Pages)
WEB_ORIGINS=https://salem.mochigogo.fun
# openssl rand -hex 32
AUTH_SECRET=
# Optional: computer players think with a self-hosted Ollama model (both must be set; leave empty for the built-in bot)
# OLLAMA_URL=http://<your-ollama-host>:11434
# OLLAMA_MODEL=<model name from `ollama list`>
